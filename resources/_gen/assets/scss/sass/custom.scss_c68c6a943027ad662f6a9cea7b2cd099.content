.page-papers h5{counter-reset:pub;border-left:4px solid #212529;padding-left:.6rem;margin:1.75rem 0 .75rem;font-size:1rem;font-weight:700;line-height:1.3}.page-papers p{counter-increment:pub;position:relative;padding-left:2.4em;margin-bottom:.65rem;line-height:1.45}.page-papers p::before{content:"[" counter(pub)"]";position:absolute;left:0;color:#6c757d;font-variant-numeric:tabular-nums}.pub-link{display:inline-block;margin-left:.2em;padding:0 .4em;border:1px solid #ced4da;border-radius:3px;font-size:.7rem;line-height:1.5;letter-spacing:.04em;text-transform:uppercase;vertical-align:1px;color:#495057}.pub-link:hover,.pub-link:focus{border-color:#007bff;color:#007bff;text-decoration:none}